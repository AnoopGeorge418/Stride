{
  "extends": "@repo/typescript-config/expo.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components"],
      "@constants/*": ["./src/constants"],
      "@types/*": ["./src/types"],
      "@tests/*": ["./src/tests"],
      "@assets/*": ["./assets/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
